---
// Big festive sale banner for the landing page — placed between the hero and collections.
// Countdown ticks to 16 Oct 2026, 00:00 IST, then flips itself into a "live" state.
const SALE_START = '2026-10-16T00:00:00+05:30';
---

<section id="sale" class="relative overflow-hidden py-20 sm:py-24" aria-label="Festive season sale — up to 15% off sitewide, starts 16 October">
    <!-- Bright festive gradient backdrop -->
    <div class="sale-bg absolute inset-0" aria-hidden="true"></div>
    <!-- Subtle gold dot texture -->
    <div class="sale-dots absolute inset-0" aria-hidden="true"></div>

    <!-- Floating festive sparkles (decorative, desktop only) -->
    <span class="sale-float hidden md:block absolute top-[14%] left-[8%] text-3xl opacity-80" style="animation-delay: 0s" aria-hidden="true">✨</span>
    <span class="sale-float hidden md:block absolute top-[62%] left-[13%] text-2xl opacity-70" style="animation-delay: 1.4s" aria-hidden="true">🪔</span>
    <span class="sale-float hidden md:block absolute top-[20%] right-[9%] text-3xl opacity-80" style="animation-delay: 0.8s" aria-hidden="true">🪔</span>
    <span class="sale-float hidden md:block absolute top-[64%] right-[14%] text-2xl opacity-70" style="animation-delay: 2.1s" aria-hidden="true">✨</span>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

        <!-- Eyebrow badge -->
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-200/40 bg-white/10 px-4 py-1.5 text-[11px] sm:text-xs font-bold uppercase tracking-[0.25em] text-amber-100 backdrop-blur-sm">
            Festive Season Sale &bull; 16 Oct Onwards
        </span>

        <!-- Headline -->
        <h2 class="font-playfair mt-6 text-4xl sm:text-5xl lg:text-6xl font-medium text-white leading-tight">
            The Festive Sale<br class="sm:hidden" />
            <span class="sale-gold-text block mt-2 text-5xl sm:text-7xl lg:text-8xl font-bold italic tracking-tight">
                Up to 15% OFF
            </span>
        </h2>

        <p class="mt-5 text-base sm:text-lg text-amber-50/90 font-light max-w-2xl mx-auto leading-relaxed">
            Celebrate the season of lights with handcrafted brass, wood &amp; decor —
            straight from Gujarat's artisans to your home.
        </p>

        <!-- Countdown / live state -->
        <div class="mt-10">
            <p id="sale-count-label" class="text-xs font-bold uppercase tracking-[0.3em] text-amber-100/80 mb-4">
                Sale starts in
            </p>

            <div id="sale-countdown" data-sale-start={SALE_START} class="grid grid-cols-4 gap-2 sm:gap-4 max-w-lg mx-auto" role="timer" aria-live="off" aria-label="Time remaining until the sale starts">
                <div class="sale-box">
                    <span id="sale-days" class="sale-num">01</span>
                    <span class="sale-unit">Days</span>
                </div>
                <div class="sale-box">
                    <span id="sale-hours" class="sale-num">00</span>
                    <span class="sale-unit">Hours</span>
                </div>
                <div class="sale-box">
                    <span id="sale-mins" class="sale-num">00</span>
                    <span class="sale-unit">Mins</span>
                </div>
                <div class="sale-box">
                    <span id="sale-secs" class="sale-num">00</span>
                    <span class="sale-unit">Secs</span>
                </div>
            </div>

            <p id="sale-live" class="hidden mt-2 text-lg sm:text-xl font-bold uppercase tracking-[0.2em] text-amber-300 drop-shadow">
                Sale is Live — Shop Before Stocks End
            </p>
        </div>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a
                href="/products"
                class="w-full sm:w-auto bg-amber-400 hover:bg-amber-300 text-stone-900 px-10 py-4 rounded-full text-sm font-bold uppercase tracking-widest shadow-xl shadow-black/20 transition-all duration-300 hover:-translate-y-0.5"
            >
                Shop the Sale
            </a>
            <a
                href="https://wa.me/919726983835?text=Hi%20Shreeyam%20Handicrafts%2C%20I%20want%20to%20know%20more%20about%20the%20Festive%20Sale%20offers."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto border-2 border-amber-100/70 text-white px-10 py-4 rounded-full text-sm font-bold uppercase tracking-widest transition-all duration-300 hover:bg-amber-50 hover:text-red-800 hover:-translate-y-0.5"
            >
                Order on WhatsApp
            </a>
        </div>

        <!-- Trust chips -->
        <div class="mt-10 flex flex-wrap justify-center gap-3">
            <span class="sale-chip">Handcrafted by Gujarat's Master Artisans</span>
            <span class="sale-chip">Direct from the Workshop — No Middlemen</span>
            <span class="sale-chip">Loved by 1,000+ Homes Across India</span>
        </div>
    </div>
</section>

<style is:global>
    @keyframes sale-shine {
        to { background-position: -200% 0; }
    }
    @keyframes sale-floaty {
        0%, 100% { transform: translateY(0) rotate(-6deg); }
        50% { transform: translateY(-14px) rotate(6deg); }
    }
    @media (prefers-reduced-motion: reduce) {
        .sale-gold-text, .sale-float { animation: none !important; }
    }
</style>

<style>
    .font-playfair {
        font-family: 'Playfair Display', serif;
    }

    /* Bright festive gradient: deep festive red -> saffron -> amber, with a gold glow */
    .sale-bg {
        background:
            radial-gradient(circle at 50% -20%, rgba(255, 224, 130, 0.55), transparent 55%),
            linear-gradient(115deg, #7f1d1d 0%, #b91c1c 28%, #ea580c 62%, #f59e0b 100%);
    }

    .sale-dots {
        background-image: radial-gradient(rgba(255, 255, 255, 0.13) 1px, transparent 1.6px);
        background-size: 22px 22px;
    }

    /* Gold gradient text with a travelling shine sweep */
    .sale-gold-text {
        background: linear-gradient(90deg, #fde68a, #fbbf24, #fffbeb, #f59e0b, #fde68a);
        background-size: 200% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: sale-shine 3.5s linear infinite;
    }

    .sale-float {
        animation: sale-floaty 4.5s ease-in-out infinite;
    }

    .sale-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 0.85rem 0.5rem 0.6rem;
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .sale-num {
        font-family: 'Playfair Display', serif;
        font-size: 1.65rem;
        font-weight: 700;
        line-height: 1;
        color: #fde047;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
        font-variant-numeric: tabular-nums;
    }
    @media (min-width: 640px) {
        .sale-num { font-size: 2.6rem; }
    }

    .sale-unit {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: rgba(255, 255, 255, 0.75);
    }
    @media (min-width: 640px) {
        .sale-unit { font-size: 0.7rem; }
    }

    .sale-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.95rem;
        border-radius: 9999px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }
</style>

<script>
    // Countdown to sale start (16 Oct 2026, 00:00 IST). Flips into a live state after.
    // The sale start time is passed from the frontmatter via the data-sale-start
    // attribute — variables are NOT interpolated inside bundled <script> tags.
    const startAttr = document.getElementById('sale-countdown')?.dataset.saleStart;
    const saleStart = startAttr ? new Date(startAttr).getTime() : Number.NaN;

    const pad = (n: number) => String(n).padStart(2, '0');
    const $ = (id: string) => document.getElementById(id);

    function tick() {
        // If the date is somehow missing/invalid, keep the server-rendered values.
        if (!Number.isFinite(saleStart)) return;
        const diff = saleStart - Date.now();
        if (diff <= 0) {
            // Sale has begun — show the live message, drop the countdown.
            $('sale-countdown')?.classList.add('hidden');
            $('sale-count-label')?.classList.add('hidden');
            $('sale-live')?.classList.remove('hidden');
            return;
        }
        const total = Math.floor(diff / 1000);
        const days = Math.floor(total / 86400);
        const hours = Math.floor((total % 86400) / 3600);
        const mins = Math.floor((total % 3600) / 60);
        const secs = total % 60;
        const daysEl = $('sale-days');
        const hoursEl = $('sale-hours');
        const minsEl = $('sale-mins');
        const secsEl = $('sale-secs');
        if (daysEl) daysEl.textContent = pad(days);
        if (hoursEl) hoursEl.textContent = pad(hours);
        if (minsEl) minsEl.textContent = pad(mins);
        if (secsEl) secsEl.textContent = pad(secs);
    }

    tick();
    if (Number.isFinite(saleStart)) setInterval(tick, 1000);
</script>
